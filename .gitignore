# ============================================================================
# ScapegoatBot .gitignore
# ============================================================================

# ---- Rust 编译产物 ----
/target/

# ---- 用户配置（含 API Key、QQ 号等敏感信息）----
config.toml
.env
.env.*

# ---- 运行时用户数据（聊天记录、AI 记忆等）----
# workspace/ 下的模板文件（*.md）由项目提供，作为初始工作区结构
# 但运行时产生的子目录必须排除
workspace/messages/
workspace/temp/
workspace/logs/

# ---- 密钥和证书 ----
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ---- 日志 ----
*.log
*.log.*
*.log.gz
/logs/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.vim/

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- 临时和备份文件 ----
*.bak
*.tmp
*.orig

# ---- Agent 本地记录与工作树 ----
# .agents/ 下名字中含 `.local` 段的记录属于用户/机器私有，不进入共享历史：
# MEMORY.local.md、TODO.local.md、memory/<name>.local.md、plan/<name>.local.md。
# 这里按 `.local` 段精确匹配，不使用更宽松的 `*.local*`，以免误伤
# i18n.locale.md 这类名字中恰好含 "local" 的共享文件。
/.agents/**/*.local.*
# 无扩展名的 `.local` 文件和目录同样属于本地记录。
/.agents/**/*.local

# 工作树拥有自己独立的 Git 状态，不能进入主检出的历史。
# Agent 默认把工作树建在 .worktrees/；Claude Code 的工作树工具则使用
# .claude/worktrees/。
/.worktrees/
/.claude/worktrees/
